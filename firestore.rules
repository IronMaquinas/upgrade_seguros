rules_version = '2';

// firestore.rules — Upgrade Seguros
//
// Etapa 15: só USUÁRIO ATIVO (logado + cadastro em users/{uid} + ativo != false).
// Etapa 16b: cada usuário só enxerga a PRÓPRIA corretora.
//
//   users/{uid}                    cadastro de login (empresaId = a corretora)
//   corretoras/{e}                 cadastro da corretora
//   corretoras/{e}/<coleção>/…     dados da corretora (Etapa 16)
//   nps_indice/{claimId}           claimId → empresaId (só o app grava; o
//                                  servidor lê para o NPS sem login)
//   plataforma_*                   Etapa 21: portal da plataforma (admin do SaaS).
//                                  Só o servidor grava (Function "plataforma" e o
//                                  script do dono). O app só lê a própria conta.
//   catalogo_seguradoras/{id}      Etapa 22: catálogo único de seguradoras. Só o
//                                  servidor grava; usuários leem as aprovadas e as
//                                  pendentes que a própria corretora sugeriu.
//
// Quem pode o quê dentro da corretora:
//   • ler e gravar sinistros, assistências, clientes, tarefas…: membro
//   • EXCLUIR sinistro, assistência ou cliente: só gestor (administrador)
//   • configurações (app_config, sla_configs, pdf_signatures, seguradoras,
//     workshops) e o cadastro da corretora: só gestor; o membro só lê
// As coleções antigas da raiz (sinistros/, clientes/ …) ficam bloqueadas:
// nenhuma regra as libera.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function docUsuario() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function perfil() {
      return get(docUsuario()).data;
    }

    function ativo() {
      return logado()
        && exists(docUsuario())
        && perfil().get('ativo', true) != false;
    }

    function admin() {
      return ativo() && perfil().get('role', '') == 'admin';
    }

    function minhaEmpresa() {
      return perfil().get('empresaId', '');
    }

    // Usuário ativo ligado à corretora [e].
    function membro(e) {
      return ativo() && e != '' && minhaEmpresa() == e;
    }

    // Gestor (administrador) da corretora [e].
    function gestor(e) {
      return membro(e) && perfil().get('role', '') == 'admin';
    }

    // Campos do próprio cadastro que só o administrador muda.
    function mexeEmCampoProtegido() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'ativo', 'empresaId', 'corretoraId', 'matricula', 'username']);
    }

    // ── users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      // o próprio cadastro, ou colegas da mesma corretora (as listas do app
      // filtram por empresaId — a regra exige esse filtro)
      allow get: if ativo()
        && (uid == request.auth.uid || resource.data.get('empresaId', '') == minhaEmpresa());
      allow list: if ativo() && resource.data.get('empresaId', '') == minhaEmpresa();

      // administrador só cria/edita/apaga usuários da PRÓPRIA corretora
      allow create: if admin() && request.resource.data.get('empresaId', '') == minhaEmpresa();
      allow delete: if admin() && resource.data.get('empresaId', '') == minhaEmpresa();
      allow update: if (admin()
          && resource.data.get('empresaId', '') == minhaEmpresa()
          && request.resource.data.get('empresaId', '') == minhaEmpresa())
        || (ativo() && request.auth.uid == uid && !mexeEmCampoProtegido());
    }

    // ── corretoras ─────────────────────────────────────────────────────────
    // ── Etapa 23: módulos do plano ─────────────────────────────────────────
    // plataforma_contas/{e}: sem conta ou plano "tudo_ligado" = tudo liberado;
    // "personalizado" = só os ids de "modulos" (catálogo em lib/utils/modulos.dart).
    function contaPath(e) {
      return /databases/$(database)/documents/plataforma_contas/$(e);
    }
    function moduloLigado(e, m) {
      return m == ''
        || !exists(contaPath(e))
        || get(contaPath(e)).data.get('plano', {}).get('tipo', 'tudo_ligado') == 'tudo_ligado'
        || m in get(contaPath(e)).data.get('modulos', []);
    }
    // ── Etapa 25: só leitura ───────────────────────────────────────────────
    // Teste encerrado, suspensa ou cancelada — ou "teste" com testeAte já
    // vencido (não depende de rotina agendada) — a corretora só LÊ.
    // Mesma conta em functions/conta.js (situacaoEfetiva / contaGrava).
    function contaLivre(c) {
      return !(c.get('situacao', 'ativa') in ['teste_encerrado', 'suspensa', 'cancelada'])
        && !(c.get('situacao', 'ativa') == 'teste'
             && c.get('testeAte', null) != null
             && c.get('testeAte', null) < request.time);
    }
    function contaGrava(e) {
      return !exists(contaPath(e)) || contaLivre(get(contaPath(e)).data);
    }
    // Coleção da corretora → módulo que ela exige para GRAVAR ('' = sempre).
    function moduloDaColecao(c) {
      return c == 'assistencias' ? 'assistencias'
        : c == 'tasks' ? 'tarefas'
        : c == 'workshops' ? 'oficinas'
        : c == 'modelos_relatorio' ? 'relatorios_personalizados'
        : c == 'nps_pesquisas' ? 'nps'
        : '';
    }

    match /corretoras/{e} {
      allow read: if membro(e);
      allow write: if gestor(e) && contaGrava(e); // Etapa 25

      match /{colecao}/{documento=**} {
        allow read: if membro(e);

        // configurações e cadastros de apoio: só o gestor altera
        allow create, update: if (colecao in ['app_config', 'sla_configs', 'pdf_signatures', 'seguradoras', 'workshops']
          ? gestor(e)
          : membro(e))
          && moduloLigado(e, moduloDaColecao(colecao)) // Etapa 23
          && contaGrava(e); // Etapa 25

        // excluir atendimento/cliente e configurações: só o gestor
        allow delete: if colecao in ['sinistros', 'assistencias', 'clientes',
                                     'app_config', 'sla_configs', 'pdf_signatures', 'seguradoras', 'workshops']
          ? gestor(e) && contaGrava(e)
          : membro(e) && contaGrava(e); // Etapa 25
      }
    }

    // ── índice do NPS (Etapa 16) ───────────────────────────────────────────
    match /nps_indice/{claimId} {
      allow create, update: if ativo() && request.resource.data.get('empresaId', '') == minhaEmpresa();
      // leitura só pelo servidor (Function npsPublico)
    }

    // ── plataforma (Etapa 21) ──────────────────────────────────────────────
    // Conta da corretora (plano, situação): membros leem a própria (para
    // "Meu plano", Etapa 23). Ninguém grava pelo app — nem o gestor.
    match /plataforma_contas/{e} {
      allow get: if membro(e);
      match /historico/{h} {
        allow read: if gestor(e);
      }
    }
    // O admin confere o próprio registro; auditoria e o resto: só o servidor.
    match /plataforma_admins/{uid} {
      allow get: if logado() && request.auth.uid == uid;
    }

    // ── catálogo de seguradoras (Etapa 22) ─────────────────────────────────
    // As consultas do app filtram por situacao == 'aprovada' OU por
    // criadaPor.empresaId == a própria corretora (a regra exige esse filtro).
    match /catalogo_seguradoras/{id} {
      allow read: if ativo()
        && (resource.data.situacao == 'aprovada'
            || resource.data.criadaPor.empresaId == minhaEmpresa());
    }

    // Qualquer outro caminho (inclusive as coleções antigas da raiz): bloqueado.
  }
}
